# ─── ORBITAL Environment Variables ───────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is already in .gitignore.

# ── NASA API ─────────────────────────────────────────────────────────────────
# Get a free key at https://api.nasa.gov/
# Use DEMO_KEY for low-rate local development.
NASA_API_KEY=DEMO_KEY

# ── Database ─────────────────────────────────────────────────────────────────
# Optional. Leave empty for local development without persistence.
DATABASE_URL=

# ── AI Provider ──────────────────────────────────────────────────────────────
# AI_PROVIDER controls which AI backend is used.
#   mock     — deterministic local responses, no external calls (default)
#   watsonx  — IBM watsonx.ai / Granite via the /ml/v1/text/chat API
AI_PROVIDER=mock

# IBM Cloud API key — used server-side only to obtain IAM bearer tokens.
# Required when AI_PROVIDER=watsonx.
# NEVER expose this value to the browser (do not prefix with NEXT_PUBLIC_).
AI_API_KEY=

# ── IBM watsonx.ai ────────────────────────────────────────────────────────────
# Required when AI_PROVIDER=watsonx.

# Your watsonx.ai project ID (found in the Project → Manage tab).
WATSONX_PROJECT_ID=

# Regional endpoint for your watsonx instance.
# Examples:
#   https://us-south.ml.cloud.ibm.com   (Dallas)
#   https://eu-de.ml.cloud.ibm.com      (Frankfurt)
#   https://eu-gb.ml.cloud.ibm.com      (London)
#   https://jp-tok.ml.cloud.ibm.com     (Tokyo)
WATSONX_URL=https://eu-de.ml.cloud.ibm.com

# Granite model ID available in your watsonx project.
# Common choices (verify availability in your region/project):
#   ibm/granite-3-8b-instruct      (8B parameter instruct model)
#   ibm/granite-3-2b-instruct      (2B parameter, faster/cheaper)
#   ibm/granite-13b-instruct-v2    (older 13B instruct model)
# Check available models at:
#   https://dataplatform.cloud.ibm.com/docs/content/wsj/analyze-data/fm-models.html
WATSONX_MODEL_ID=ibm/granite-4-h-small

# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
