# ___ ORBITAL Environment Variables ___________________________________________
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local -- it is already in .gitignore.

# __ NASA API __________________________________________________________________
# Get a free key at https://api.nasa.gov/
# Use DEMO_KEY for low-rate local development.
NASA_API_KEY=DEMO_KEY

# __ Database __________________________________________________________________
# Optional. Leave empty for local development without persistence.
DATABASE_URL=

# __ AI Provider _______________________________________________________________
# AI_PROVIDER controls which AI backend is used.
#   mock     -- deterministic local responses, no external calls (default)
#   gemini   -- Google Gemini API (FREE tier) via Gemini REST API
#   watsonx  -- IBM watsonx.ai / Granite via the /ml/v1/text/chat API
AI_PROVIDER=mock

# __ Google Gemini (FREE tier) ________________________________________________
# Get a free key at: https://aistudio.google.com/app/apikey
# Set AI_PROVIDER=gemini to activate.
# IMPORTANT: Keep this server-side ONLY. Never use NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=

# Gemini model -- free tier model. Default: gemini-3.5-flash (verified free tier
# as of 2026-09; gemini-2.0-flash, the previous default, has since been shut
# down by Google -- models get deprecated on a rolling basis, so if requests
# start failing, check https://ai.google.dev/gemini-api/docs/models for the
# current list before assuming the integration itself is broken).
GEMINI_MODEL=gemini-3.5-flash

# __ IBM watsonx.ai ___________________________________________________________
# Required when AI_PROVIDER=watsonx.

# IBM Cloud API key -- used server-side only to obtain IAM bearer tokens.
# Required when AI_PROVIDER=watsonx.
# NEVER expose this value to the browser (do not prefix with NEXT_PUBLIC_).
AI_API_KEY=

# Your watsonx.ai project ID (found in the Project -> Manage tab).
WATSONX_PROJECT_ID=

# Regional endpoint for your watsonx instance.
WATSONX_URL=https://eu-de.ml.cloud.ibm.com

# Granite model ID available in your watsonx project.
WATSONX_MODEL_ID=ibm/granite-4-h-small

# __ Application _______________________________________________________________
NEXT_PUBLIC_APP_URL=http://localhost:3000
